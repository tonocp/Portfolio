---
import { getCollection, type CollectionEntry } from "astro:content";

import AboutSection from "../components/AboutSection.astro";
import CapabilitiesSection from "../components/CapabilitiesSection.astro";
import ContactSection from "../components/ContactSection.astro";
import HeroSection from "../components/HeroSection.astro";
import ProjectsSection from "../components/ProjectsSection.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteContent } from "../data/site";

const projects = (await getCollection("projects"))
  .filter((project: CollectionEntry<"projects">) => project.data.featured)
  .sort((a: CollectionEntry<"projects">, b: CollectionEntry<"projects">) => a.data.order - b.data.order);
---

<BaseLayout title={siteContent.seo.title} description={siteContent.seo.description}>
  <header class="topbar">
    <div class="shell topbar-inner">
      <a class="brand" href="#home">TCarrascosa.dev</a>
      <nav aria-label="Principal">
        <a href="#sobre-mi">Sobre mí</a>
        <a href="#stack">Stack</a>
        <a href="#proyectos">Proyectos</a>
        <a href="#contacto">Contacto</a>
      </nav>
    </div>
  </header>

  <main>
    <div id="home" class="anchor-target" aria-hidden="true"></div>
    <HeroSection
      eyebrow={siteContent.hero.eyebrow}
      title={siteContent.hero.title}
      intro={siteContent.hero.intro}
      primaryCta={siteContent.hero.primaryCta}
      secondaryCta={siteContent.hero.secondaryCta}
      metrics={siteContent.hero.metrics}
    />
    <div id="sobre-mi" class="anchor-target" aria-hidden="true"></div>
    <AboutSection title={siteContent.about.title} body={siteContent.about.body} />
    <div id="stack" class="anchor-target" aria-hidden="true"></div>
    <CapabilitiesSection
      title={siteContent.capabilities.title}
      items={siteContent.capabilities.items}
      stack={siteContent.capabilities.stack}
    />
    <div id="proyectos" class="anchor-target" aria-hidden="true"></div>
    <ProjectsSection projects={projects} />
    <div id="contacto" class="anchor-target" aria-hidden="true"></div>
    <ContactSection
      title={siteContent.contact.title}
      body={siteContent.contact.body}
      links={siteContent.contact.links}
    />
  </main>
</BaseLayout>

---
import Brand from "../components/Brand.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="404 · Toño Carrascosa Prieto"
  description="Página no encontrada / Page not found."
  locale="es"
>
  <header class="topbar">
    <div class="shell topbar-inner">
      <Brand href="/" label="TCarrascosa.dev" />
    </div>
  </header>

  <main class="not-found section shell">
    <p class="eyebrow">404</p>
    <h1>Página no encontrada</h1>
    <p class="not-found-lead">La página que buscas no existe o se ha movido.</p>
    <p class="not-found-lead not-found-lead-en">This page doesn't exist or has moved.</p>
    <div class="not-found-actions">
      <a class="button button-primary" href="/">Volver al inicio</a>
      <a class="button button-secondary" href="/en/">Back to home</a>
    </div>
  </main>
</BaseLayout>

---
import { getAbsoluteLocaleUrl } from "astro:i18n";

import "../styles/global.css";
import { defaultLocale, locales, type Locale } from "../i18n";

interface Props {
  title: string;
  description: string;
  locale: Locale;
}

const { title, description, locale } = Astro.props;
const defaultLocaleUrl = getAbsoluteLocaleUrl(defaultLocale, "/");
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;600;700&family=Space+Grotesk:wght@700&display=swap"
      rel="stylesheet"
    />
    {locales.map((entry) => <link rel="alternate" hreflang={entry} href={getAbsoluteLocaleUrl(entry, "/")} />)}
    <link rel="alternate" hreflang="x-default" href={defaultLocaleUrl} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

---
interface Props {
  eyebrow: string;
  title: string;
  body: readonly string[];
}

const { eyebrow, title, body } = Astro.props;
---

<section class="section shell section-split">
  <div class="section-heading" data-reveal>
    <p class="eyebrow">{eyebrow}</p>
    <h2>{title}</h2>
  </div>
  <div class="section-body prose" data-reveal style="--reveal-delay: 120ms">
    {body.map((paragraph) => <p set:html={paragraph} />)}
  </div>
</section>

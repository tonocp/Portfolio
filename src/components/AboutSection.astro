---
interface Props {
  title: string;
  body: readonly string[];
}

const { title, body } = Astro.props;
---

<section class="section shell section-split">
  <div class="section-heading">
    <p class="eyebrow">Sobre mí</p>
    <h2>{title}</h2>
  </div>
  <div class="section-body prose">
    {body.map((paragraph) => <p set:html={paragraph} />)}
  </div>
</section>

---
interface Capability {
  title: string;
  description: string;
}

interface Props {
  title: string;
  items: readonly Capability[];
  stack: readonly string[];
}

const { title, items, stack } = Astro.props;
---

<section class="section shell capabilities">
  <div class="section-heading">
    <p class="eyebrow">Stack</p>
    <h2>{title}</h2>
  </div>

  <div class="capability-grid">
    {
      items.map((item) => (
        <article class="capability-card">
          <h3>{item.title}</h3>
          <p>{item.description}</p>
        </article>
      ))
    }
  </div>

  <ul class="stack-cloud" aria-label="Stack principal">
    {stack.map((item) => <li>{item}</li>)}
  </ul>
</section>

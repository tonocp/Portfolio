---
import type { Action, Metric } from "../i18n";

interface Props {
  eyebrow: string;
  title: string;
  intro: string;
  primaryCta: Action;
  secondaryCta: Action;
  metrics: readonly Metric[];
  metricsAriaLabel: string;
  nowText: string;
}

const { eyebrow, title, intro, primaryCta, secondaryCta, metrics, metricsAriaLabel, nowText } = Astro.props;
---

<section class="hero section shell">
  <div class="hero-fold">
    <div class="hero-copy" data-reveal>
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      <p class="hero-intro">{intro}</p>
      <div class="hero-actions">
        <a class="button button-primary" href={primaryCta.href}>{primaryCta.label}</a>
        <a class="button button-secondary" href={secondaryCta.href}>{secondaryCta.label}</a>
      </div>
    </div>
  </div>

  <div class="hero-panel" data-reveal style="--reveal-delay: 150ms">
    <ul class="metric-grid" aria-label={metricsAriaLabel}>
      {
        metrics.map((metric) => (
          <li class="metric-card">
            <span>{metric.label}</span>
            <strong>{metric.value}</strong>
          </li>
        ))
      }
    </ul>
    <div class="terminal-window">
      <div class="terminal-titlebar">
        <span class="terminal-dot dot-red" aria-hidden="true"></span>
        <span class="terminal-dot dot-yellow" aria-hidden="true"></span>
        <span class="terminal-dot dot-green" aria-hidden="true"></span>
        <span class="terminal-titlebar-label">~/status</span>
      </div>
      <div class="signal-card">
        <span class="signal-dot" aria-hidden="true"></span>
        <p>{nowText}</p>
      </div>
    </div>
  </div>
</section>

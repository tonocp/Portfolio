---
interface Metric {
  value: string;
  label: string;
}

interface Action {
  label: string;
  href: string;
}

interface Props {
  eyebrow: string;
  title: string;
  intro: string;
  primaryCta: Action;
  secondaryCta: Action;
  metrics: readonly Metric[];
}

const { eyebrow, title, intro, primaryCta, secondaryCta, metrics } = Astro.props;
---

<section class="hero section shell">
  <div class="hero-copy">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p class="hero-intro">{intro}</p>
    <div class="hero-actions">
      <a class="button button-primary" href={primaryCta.href}>{primaryCta.label}</a>
      <a class="button button-secondary" href={secondaryCta.href}>{secondaryCta.label}</a>
    </div>
  </div>

  <div class="hero-panel">
    <p class="panel-kicker">Ahora mismo</p>
    <ul class="metric-grid" aria-label="Resumen profesional">
      {
        metrics.map((metric) => (
          <li class="metric-card">
            <strong>{metric.value}</strong>
            <span>{metric.label}</span>
          </li>
        ))
      }
    </ul>
    <div class="signal-card">
      <span class="signal-dot" aria-hidden="true"></span>
      <p>Disponible para proyectos con foco en producto, calidad visual y arquitectura mantenible.</p>
    </div>
  </div>
</section>

---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Project {
  id: string;
  data: {
    title: string;
    tagline: string;
    year: number;
    stack: string[];
    summary: string;
    role: string;
    links: { label: string; href: string }[];
    featured: boolean;
    order: number;
    cover: ImageMetadata;
    theme: "amber" | "ice" | "coral" | "mint";
  };
}

interface Props {
  eyebrow: string;
  heading: string;
  lead: string;
  coverAltPrefix: string;
  stackAriaLabelPrefix: string;
  projects: Project[];
  archiveLabel: string;
  archiveProjects: Project[];
}

const { eyebrow, heading, lead, coverAltPrefix, stackAriaLabelPrefix, projects, archiveLabel, archiveProjects } =
  Astro.props;
---

<section class="section shell">
  <div class="section-heading projects-heading">
    <p class="eyebrow">{eyebrow}</p>
    <h2>{heading}</h2>
    <p class="section-lead">{lead}</p>
  </div>

  <div class="projects-grid">
    {
      projects.map((project) => (
        <article class={`project-card theme-${project.data.theme}`}>
          <div class="project-media">
            <Image src={project.data.cover} alt={`${coverAltPrefix} ${project.data.title}`} loading="lazy" />
          </div>
          <div class="project-content">
            <div class="project-meta">
              <span>{project.data.year}</span>
              <span>{project.data.role}</span>
            </div>
            <h3>{project.data.title}</h3>
            <p class="project-tagline">{project.data.tagline}</p>
            <p class="project-summary">{project.data.summary}</p>
            <ul class="stack-list" aria-label={`${stackAriaLabelPrefix} ${project.data.title}`}>
              {project.data.stack.map((item) => <li>{item}</li>)}
            </ul>
            <div class="project-links">
              {project.data.links.map((link) => <a href={link.href}>{link.label}</a>)}
            </div>
          </div>
        </article>
      ))
    }
  </div>

  <p class="stack-group-label archive-label">{archiveLabel}</p>
  <ul class="archive-list">
    {
      archiveProjects.map((project) => (
        <li class="archive-item">
          <a href={project.data.links[0].href} class="archive-title">
            {project.data.title}
          </a>
          <span class="archive-meta">
            {project.data.stack.join(" · ")} · {project.data.year}
          </span>
        </li>
      ))
    }
  </ul>
</section>

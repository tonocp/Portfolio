---
import { getCollection, type CollectionEntry } from "astro:content";

import AboutSection from "./AboutSection.astro";
import CapabilitiesSection from "./CapabilitiesSection.astro";
import ContactSection from "./ContactSection.astro";
import HeroSection from "./HeroSection.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import ProjectsSection from "./ProjectsSection.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteContent, type Locale } from "../i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = siteContent[locale];

type ProjectEntry = CollectionEntry<"projects">;

const localeProjects = (await getCollection("projects"))
  .filter((project: ProjectEntry) => project.id.startsWith(`${locale}/`))
  .sort((a: ProjectEntry, b: ProjectEntry) => a.data.order - b.data.order);

const { projects, secondaryProjects } = localeProjects.reduce(
  (acc: { projects: ProjectEntry[]; secondaryProjects: ProjectEntry[] }, project: ProjectEntry) => {
    acc[project.data.featured ? "projects" : "secondaryProjects"].push(project);
    return acc;
  },
  { projects: [], secondaryProjects: [] }
);
---

<BaseLayout title={t.seo.title} description={t.seo.description} locale={locale}>
  <header class="topbar">
    <div class="shell topbar-inner">
      <a class="brand" href="#home">{t.nav.brand}</a>
      <button type="button" class="nav-toggle" aria-expanded="false" aria-controls="site-nav" aria-label={t.nav.menuLabel}>
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
      </button>
      <nav id="site-nav" aria-label={t.nav.ariaLabel}>
        {t.nav.links.map((link) => <a href={link.href}>{link.label}</a>)}
        <LanguageSwitcher locale={locale} />
      </nav>
    </div>
  </header>

  <script>
    const toggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
    const nav = document.getElementById("site-nav");

    if (toggle && nav) {
      const closeMenu = () => {
        toggle.setAttribute("aria-expanded", "false");
        nav.classList.remove("is-open");
        document.body.classList.remove("nav-open");
      };

      const openMenu = () => {
        toggle.setAttribute("aria-expanded", "true");
        nav.classList.add("is-open");
        document.body.classList.add("nav-open");
      };

      toggle.addEventListener("click", () => {
        const isOpen = toggle.getAttribute("aria-expanded") === "true";
        isOpen ? closeMenu() : openMenu();
      });

      nav.addEventListener("click", (event) => {
        if ((event.target as HTMLElement).tagName === "A") closeMenu();
      });

      document.addEventListener("click", (event) => {
        if (!nav.contains(event.target as Node) && !toggle.contains(event.target as Node)) closeMenu();
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") closeMenu();
      });
    }
  </script>

  <main>
    <div id="home" class="anchor-target" aria-hidden="true"></div>
    <HeroSection
      eyebrow={t.hero.eyebrow}
      title={t.hero.title}
      intro={t.hero.intro}
      primaryCta={t.hero.primaryCta}
      secondaryCta={t.hero.secondaryCta}
      metrics={t.hero.metrics}
      metricsAriaLabel={t.hero.metricsAriaLabel}
      nowKicker={t.hero.nowKicker}
      nowText={t.hero.nowText}
    />
    <div id="sobre-mi" class="anchor-target" aria-hidden="true"></div>
    <AboutSection eyebrow={t.about.eyebrow} title={t.about.title} body={t.about.body} />
    <div id="stack" class="anchor-target" aria-hidden="true"></div>
    <CapabilitiesSection
      eyebrow={t.capabilities.eyebrow}
      title={t.capabilities.title}
      lead={t.capabilities.lead}
      items={t.capabilities.items}
      stackPrincipalLabel={t.capabilities.stackPrincipalLabel}
      stackPrincipal={t.capabilities.stackPrincipal}
      stackSecondaryLabel={t.capabilities.stackSecondaryLabel}
      stackGroups={t.capabilities.stackGroups}
      stackAriaLabelPrefix={t.capabilities.stackAriaLabelPrefix}
      trademarkNote={t.capabilities.trademarkNote}
    />
    <div id="proyectos" class="anchor-target" aria-hidden="true"></div>
    <ProjectsSection
      eyebrow={t.projects.eyebrow}
      heading={t.projects.heading}
      lead={t.projects.lead}
      coverAltPrefix={t.projects.coverAltPrefix}
      stackAriaLabelPrefix={t.projects.stackAriaLabelPrefix}
      projects={projects}
      secondaryLabel={t.projects.secondaryLabel}
      secondaryProjects={secondaryProjects}
    />
    <div id="contacto" class="anchor-target" aria-hidden="true"></div>
    <ContactSection
      eyebrow={t.contact.eyebrow}
      title={t.contact.title}
      body={t.contact.body}
      links={t.contact.links}
      footerBrand={t.nav.brand}
      footerBuiltWith={t.footer.builtWith}
    />
  </main>
</BaseLayout>

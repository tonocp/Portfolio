---
import { siAstro, siGithub } from "simple-icons";
import type { ContactLink } from "../i18n";

interface Props {
  eyebrow: string;
  title: string;
  body: string;
  links: readonly ContactLink[];
  footerBrand: string;
  footerBuiltWith: string;
}

const { eyebrow, title, body, links, footerBrand, footerBuiltWith } = Astro.props;
const year = new Date().getFullYear();
const contactLinks = links.filter((link) => link.group === "cta");
const socialLinks = links.filter((link) => link.group === "social");

const strokeIconAttrs = {
  fill: "none",
  stroke: "currentColor",
  "stroke-width": "1.8",
  "stroke-linecap": "round",
  "stroke-linejoin": "round"
} as const;

const socialIcons: Record<string, { viewBox: string; path: string }> = {
  github: { viewBox: "0 0 24 24", path: siGithub.path },
  linkedin: {
    viewBox: "0 0 448 512",
    path: "M416 32H31.9C14.3 32 0 46.5 0 64.3v383.4C0 465.5 14.3 480 31.9 480H416c17.6 0 32-14.5 32-32.3V64.3c0-17.8-14.4-32.3-32-32.3zM135.4 416H69V202.2h66.5V416zm-33.2-243c-21.3 0-38.5-17.3-38.5-38.5S80.9 96 102.2 96c21.2 0 38.5 17.3 38.5 38.5 0 21.3-17.2 38.5-38.5 38.5zm282.1 243h-66.4V312c0-24.8-.5-56.7-34.5-56.7-34.6 0-39.9 27-39.9 54.9V416h-66.4V202.2h63.7v29.2h.9c8.9-16.8 30.6-34.5 62.9-34.5 67.2 0 79.7 44.3 79.7 101.9V416z"
  }
};
---

<section class="section shell contact-section">
  <div class="contact-card">
    <div class="section-heading">
      <p class="eyebrow">{eyebrow}</p>
      <h2>{title}</h2>
    </div>
    <p class="section-lead">{body}</p>
    <div class="contact-links">
      <div class="contact-link-group">
        {
          contactLinks.map((link) => (
            <a
              class={`button ${link.primary ? "button-primary" : "button-secondary"}`}
              href={link.obfuscate ? "#" : link.href}
              data-obfuscated={link.obfuscate}
              target="_blank"
              rel="noreferrer"
            >
              {link.icon === "email" ? (
                <svg class="button-icon" viewBox="0 0 24 24" aria-hidden="true" {...strokeIconAttrs}>
                  <rect x="3" y="5" width="18" height="14" rx="2" />
                  <path d="M4 7l8 6 8-6" />
                </svg>
              ) : link.icon === "phone" ? (
                <svg class="button-icon" viewBox="0 0 24 24" aria-hidden="true" {...strokeIconAttrs}>
                  <path d="M5.5 4h2.7l1.3 3.9-2 1.7a11.3 11.3 0 0 0 5 5l1.7-2 3.9 1.3v2.7a1.5 1.5 0 0 1-1.6 1.5A15.8 15.8 0 0 1 4 5.6 1.5 1.5 0 0 1 5.5 4Z" />
                </svg>
              ) : null}
              {link.label}
            </a>
          ))
        }
      </div>
      <div class="contact-link-group">
        {
          socialLinks.map((link) => {
            const socialIcon = link.icon && socialIcons[link.icon];
            return (
              <a
                class="button button-secondary button-icon-only"
                href={link.href}
                title={link.label}
                target="_blank"
                rel="noreferrer"
              >
                {socialIcon ? (
                  <svg class="button-icon" viewBox={socialIcon.viewBox} fill="currentColor" aria-hidden="true">
                    <path d={socialIcon.path} />
                  </svg>
                ) : null}
                <span class="visually-hidden">{link.label}</span>
              </a>
            );
          })
        }
      </div>
    </div>
    <footer class="card-footer">
      <p>
        © {year} · {footerBrand} · {footerBuiltWith}
        <svg class="footer-icon" viewBox="0 0 24 24" fill={`#${siAstro.hex}`} aria-hidden="true">
          <path d={siAstro.path} />
        </svg>
        Astro
      </p>
    </footer>
  </div>
</section>

<script>
  import { obfuscatedContact } from "../data/contactSecrets";

  const decode = (value: string) => atob(value);

  const targets: Partial<Record<"email" | "phone", string>> = {
    email: `mailto:${decode(obfuscatedContact.email)}`,
    phone: `tel:${decode(obfuscatedContact.phone)}`
  };

  document.querySelectorAll<HTMLAnchorElement>("[data-obfuscated]").forEach((anchor) => {
    const key = anchor.dataset.obfuscated as "email" | "phone" | undefined;
    const href = key && targets[key];
    if (href) anchor.href = href;
  });
</script>

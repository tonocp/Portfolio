---
interface Link {
  label: string;
  href: string;
}

interface Props {
  eyebrow: string;
  title: string;
  body: string;
  links: readonly Link[];
}

const { eyebrow, title, body, links } = Astro.props;
---

<section class="section shell contact-section">
  <div class="contact-card">
    <div class="section-heading">
      <p class="eyebrow">{eyebrow}</p>
      <h2>{title}</h2>
    </div>
    <p class="section-lead">{body}</p>
    <div class="contact-links">
      {links.map((link) => <a class="button button-secondary" href={link.href}>{link.label}</a>)}
    </div>
  </div>
</section>
